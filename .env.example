APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.valiendovales.online
SERVER_NUMBER=1

# Base del frontend (SPA). Se usa para armar enlaces que el usuario abre en el navegador,
# como el de restablecimiento de contraseña — ver AppServiceProvider::configurePasswordResetUrl().
FRONTEND_URL=http://localhost:4200

# Orígenes permitidos por CORS, separados por coma. Nunca '*' en producción.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:4200,http://localhost:5173,https://api.valiendovales.online

# Secreto de Google reCAPTCHA v3. Vacío = en local/testing la verificación se omite
# automáticamente (ver App\Rules\Recaptcha); no hace falta llenarlo para desarrollar.
RECAPTCHA_SECRET_KEY=

# API key de Google Geocoding (mapa del Verificador). Vacío = GeocodingService no hace
# nada y latitud/longitud quedan null; no hace falta llenarlo para desarrollar.
GOOGLE_MAPS_API_KEY=

# IP(s) del balanceador de carga. Vacío = no confía en ningún proxy.
TRUSTED_PROXIES=

# Dominio/subdominio (sin protocolo) resoluble solo desde la VPN, para las rutas con
# middleware 'vpn' (detección por host, no por IP). Vacío = no bloquea nada.
VPN_HOST=

# Expiración absoluta del token (minutos) y cierre de sesión por inactividad (minutos).
# Independientes entre sí — ver config/sanctum.php y App\Http\Middleware\EnsureTokenNotIdle.
SANCTUM_TOKEN_EXPIRATION_MINUTES=480
IDLE_TIMEOUT_MINUTES=15

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@valiendovales.online"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP (alternativa si no usas Resend)
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nyc3
AWS_BUCKET=
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
