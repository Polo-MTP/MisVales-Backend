# Plantilla de producción. Copiar a .env.production y llenar con valores reales:
#   cp .env.production.example .env.production
#
# .env.production NUNCA se sube a git (ver .gitignore) — vive solo en el servidor real
# o en el gestor de secretos de quien despliegue.

APP_NAME="MisVales"
APP_ENV=production
# Generar con: php artisan key:generate --show
# (--show imprime la llave en vez de escribirla a un .env; el contenedor de producción
# no tiene ningún .env adentro, ver .dockerignore — la llave llega vía docker-compose)
APP_KEY=
APP_DEBUG=false
APP_URL=https://cambia-esto-por-tu-dominio-real.com

# Base del frontend (SPA) — el link de restablecimiento de contraseña apunta aquí, no a la API.
FRONTEND_URL=https://cambia-esto-por-el-dominio-real-del-frontend.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# La app se conecta al servicio "mysql" del propio docker-compose.prod.yml — estas
# credenciales son las que también usa ese servicio para inicializar la base.
DB_DATABASE=misvales_prod
DB_USERNAME=misvales
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Si cambian a MAIL_MAILER=resend, RESEND_API_KEY es obligatoria — sin ella, el correo del
# tercer factor (roles con factor_count=3: Gerente de Sucursal, Gerente General, Administrador)
# falla y ese login se queda atorado.
MAIL_MAILER=smtp
RESEND_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Dominios reales del frontend, separados por coma. Debe incluir el mismo dominio que FRONTEND_URL.
CORS_ALLOWED_ORIGINS=https://cambia-esto-por-el-dominio-real-del-frontend.com

# Secreto de Google reCAPTCHA v3 (login, forgot/reset-password, MFA). Sin esto, cualquier
# verificación real de reCAPTCHA falla (Google rechaza secret vacío) — 'bypass-recaptcha'
# solo funciona en local/testing, no aquí.
RECAPTCHA_SECRET_KEY=

# API key de Google Geocoding API (habilitarla en Google Cloud, con facturación activa).
# Sin esto, las direcciones nuevas/editadas no obtienen latitud/longitud y el Verificador
# no ve el pin en el mapa — no bloquea el resto del flujo.
GOOGLE_MAPS_API_KEY=

# IP del balanceador. Si el dominio público pasa por Cloudflare (proxied), agregar también
# sus rangos publicados en cloudflare.com/ips.
TRUSTED_PROXIES=

# Dominio/subdominio (sin protocolo) por el que infra publica las rutas de decisión SOLO
# dentro de la VPN (p.ej. "vpn.misvales.com"). VerifyVpnAccess compara esto contra el host
# de la petición — no depende de TRUSTED_PROXIES ni de IP.
VPN_HOST=

# Expiración absoluta del token (minutos) y cierre de sesión por inactividad (minutos).
# Independientes entre sí — ver config/sanctum.php y App\Http\Middleware\EnsureTokenNotIdle.
SANCTUM_TOKEN_EXPIRATION_MINUTES=480
IDLE_TIMEOUT_MINUTES=15
