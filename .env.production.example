# Plantilla de producción. Copiar a .env.production y llenar con valores reales:
#   cp .env.production.example .env.production
#
# .env.production NUNCA se sube a git (ver .gitignore) — vive solo en el servidor real
# o en el gestor de secretos de quien despliegue.

APP_NAME="MisVales"
APP_ENV=production
# Generar con: php artisan key:generate --show
# (--show imprime la llave en vez de escribirla a un .env; el contenedor de producción
# no tiene ningún .env adentro, ver .dockerignore — la llave llega vía docker-compose)
APP_KEY=
APP_DEBUG=false
APP_URL=https://cambia-esto-por-tu-dominio-real.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# La app se conecta al servicio "mysql" del propio docker-compose.prod.yml — estas
# credenciales son las que también usa ese servicio para inicializar la base.
DB_DATABASE=misvales_prod
DB_USERNAME=misvales
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Dominio(s) reales del frontend, separados por coma. Nunca '*' en producción — ver
# config/cors.php.
CORS_ALLOWED_ORIGINS=https://cambia-esto-por-tu-dominio-real.com
